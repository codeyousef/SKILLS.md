{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anti-Slop adapter",
  "type": "object",
  "required": ["schemaVersion", "id", "displayName", "enforcement", "detection", "guidance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "enforcement": { "enum": ["native", "advisory"] },
    "detection": {
      "type": "object",
      "required": ["manifests", "extensions"],
      "properties": {
        "manifests": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "extensions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "check": {
      "type": "object",
      "required": ["argv", "cwd"],
      "properties": {
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "cwd": { "type": "string" }
      }
    },
    "guidance": { "type": "string", "minLength": 1 }
  }
}

